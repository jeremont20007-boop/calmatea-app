# ─── Supabase (obligatorio) ───────────────────────────────────────────────────
# Dashboard: https://supabase.com → tu proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── MercadoPago (para pagos de anuncios) ─────────────────────────────────────
# Dashboard: https://developers.mercadopago.com → Mis aplicaciones → Credenciales
MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000

# ─── Stripe (para suscripciones premium) ─────────────────────────────────────
# Dashboard: https://dashboard.stripe.com → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Dashboard: https://dashboard.stripe.com → Products → tu producto premium → precio ID
STRIPE_PREMIUM_PRICE_ID=price_...

# ─── App URL ──────────────────────────────────────────────────────────────────
# En local: http://localhost:3000
# En producción: https://tu-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── PayWay (opcional, para pagos con tarjeta argentina) ─────────────────────
# Solo necesario si activás el flujo de PayWay
# PAYWAY_API_KEY=
# PAYWAY_SITE_ID=
# PAYWAY_TEMPLATE_ID=
