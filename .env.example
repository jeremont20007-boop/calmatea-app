# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno.
# Copiá este archivo como .env.local y completá cada valor.
# NUNCA subas al repositorio un archivo con valores reales.
# Explicación de cada variable: docs/VARIABLES.md
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase (base de datos, login y archivos) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Dirección pública de la app (sin barra al final) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Mercado Pago (pago de Premium y de anuncios) ---
MP_ACCESS_TOKEN=

# --- PayWay / Prisma (pago alternativo de Premium) ---
PAYWAY_API_KEY=
PAYWAY_SITE_ID=
PAYWAY_TEMPLATE_ID=

# --- Stripe (código heredado; hoy no se usa desde la interfaz) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
