# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_PREMIUM_PRICE_ID=your_stripe_premium_price_id

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MercadoPago
MP_ACCESS_TOKEN=your_mercadopago_access_token

# PayWay
PAYWAY_API_KEY=your_payway_api_key
PAYWAY_SITE_ID=your_payway_site_id
PAYWAY_TEMPLATE_ID=your_payway_template_id
# Secreto propio (inventalo, mínimo 16 caracteres) para firmar la URL de aviso de pagos.
# Generar uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYWAY_WEBHOOK_SECRET=your_random_secret_min_16_chars
